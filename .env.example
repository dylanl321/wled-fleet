# Copy to .env and adjust. Empty ADMIN_PASSWORD leaves the UI open on the LAN.
PORT=8787
TZ=America/New_York
PUID=568
PGID=568
DATA_PATH=/mnt/tank/apps/wled-fleet
ADMIN_PASSWORD=
SCAN_SUBNETS=
EXTRA_HOSTS=
BACKUP_INTERVAL=86400
BACKUP_WATCH_INTERVAL=900
BACKUP_RETENTION=30
DISCOVERY_INTERVAL=60
PRESENCE_INTERVAL=20
WLED_GITHUB_REPO=wled/WLED
QUINLED_GITHUB_REPO=intermittech/QuinLED-Firmware
WLED_FLEET_IMAGE=ghcr.io/your-user/wled-fleet:latest
